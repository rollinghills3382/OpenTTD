/*
 * Service station (1950s) - a 2x2 town building for OpenTTD.
 *
 * GENERATED by tools/make_sprites.py - edit that script, not this file.
 */

grf {
    grfid:       "TT\01\05";
    name:        string(STR_GRF_NAME);
    desc:        string(STR_GRF_DESC);
    version:     1;
    min_compatible_version: 1;
}

cargotable { PASS, MAIL, GOOD }

/* ---- Sprites and layouts, one per tile of the 2x2 house -------------- */
spriteset (spr_garage, "gfx/gas_station.png") { [4, 4, 60, 44, -30, -16] }

spritelayout layout_garage {
    ground { sprite: GROUNDSPRITE_CONCRETE; }
    building {
        sprite: spr_garage;
        xoffset: 0; yoffset: 0; zoffset: 0;
        xextent: 15; yextent: 15; zextent: 19;
    }
}

spriteset (spr_sign, "gfx/gas_station.png") { [68, 4, 26, 39, -10, -25] }

spritelayout layout_sign {
    ground { sprite: GROUNDSPRITE_CONCRETE; }
    building {
        sprite: spr_sign;
        xoffset: 4; yoffset: 2; zoffset: 0;
        xextent: 6; yextent: 12; zextent: 29;
    }
}

spriteset (spr_parking, "gfx/gas_station.png") { [98, 4, 34, 19, -16, -4] }

spritelayout layout_parking {
    ground { sprite: GROUNDSPRITE_CONCRETE; }
    building {
        sprite: spr_parking;
        xoffset: 3; yoffset: 3; zoffset: 0;
        xextent: 10; yextent: 9; zextent: 5;
    }
}

spriteset (spr_canopy, "gfx/gas_station.png") { [136, 4, 56, 41, -28, -15] }

spritelayout layout_canopy {
    ground { sprite: GROUNDSPRITE_CONCRETE; }
    building {
        sprite: spr_canopy;
        xoffset: 1; yoffset: 1; zoffset: 0;
        xextent: 14; yextent: 14; zextent: 15;
    }
}


switch (FEAT_HOUSES, SELF, sw_gas_station_tile, house_tile) {
    HOUSE_TILE_NORTH: layout_garage;
    HOUSE_TILE_WEST: layout_sign;
    HOUSE_TILE_EAST: layout_parking;
    HOUSE_TILE_SOUTH: layout_canopy;
}

item (FEAT_HOUSES, gas_station, -1, HOUSE_SIZE_2X2) {
    property {
        substitute:              0x14; /* stadium (a 2x2 base house) */
        building_flags:          bitmask(HOUSE_FLAG_NOT_SLOPED, HOUSE_FLAG_PROTECTED);
        name:                    string(STR_GAS_STATION);
        years_available:         [1950, 65535];
        minimum_lifetime:        255;
        population:              10;
        mail_multiplier:         20;
        accepted_cargos:         [[PASS, 4], [MAIL, 2], [GOOD, 8]];
        local_authority_impact:  100;
        removal_cost_multiplier: 80;
        /* Never grown by towns: placed by hand with the house picker only. */
        probability:             0;
        building_class:          0;
        /* Listed under "town centre" in the house picker; temperate, sub-arctic and sub-tropical. */
        availability_mask:       [bitmask(4), bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPIC)];
    }
    graphics {
        sw_gas_station_tile;
    }
}
